{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/assets/(.*)",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|svg|css|js|json|webmanifest))",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend", "path": "/index.html" }
    }
  ]
}
